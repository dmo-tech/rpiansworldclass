# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LeadGridd CRM (app/leadGridd.ts): the "book your strategy call" form is also
# added there as a contact. Server-only; leave empty to send nothing.
LEADGRIDD_API_TOKEN=

# Analytics / marketing tags (app/trackingScripts.tsx). Each loads only after
# the visitor accepts its cookie category; leave one empty to switch it off.
# NEXT_PUBLIC_* values are built into the site, so rebuild after changing them.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
