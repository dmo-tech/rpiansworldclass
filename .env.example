# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp alerts (Maytapi) and LeadGridd CRM contacts (app/leadAlerts.ts),
# sent from the server for new leads, strategy-call (video) form leads and
# payments. Server-only; a missing value only stops that part (and is logged).
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_TOKEN=
# Who gets the WhatsApp alerts: comma separated, with country code
# (91 and the 10-digit mobile).
ALERT_NUMBERS=
# Strategy-call (video) form contacts.
LEADGRIDD_TOKEN_VIDEO=
# ₹999 payment contacts.
LEADGRIDD_TOKEN_PAYMENT=
# Turns on /api/alerts/test?secret=<this value>; leave empty to keep it off.
ALERT_TEST_SECRET=

# Analytics / marketing tags (app/trackingScripts.tsx). Each loads only after
# the visitor accepts its cookie category; leave one empty to switch it off.
# NEXT_PUBLIC_* values are built into the site, so rebuild after changing them.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
